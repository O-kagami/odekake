{
  "name": "odekake-note",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "../01-start/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odekake-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
